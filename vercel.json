{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile",
      "command": ["sh", "-c", "exec uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-80}"]
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "bindings": [
        { "type": "service", "service": "backend", "format": "url", "env": "BACKEND_URL" }
      ]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
