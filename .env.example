
# Copy this file to .env for local development. Generate real local secrets;
# never commit .env or use these sample values outside your own machine.

# PostgreSQL
POSTGRES_DB=dw
POSTGRES_USER=dw
POSTGRES_PASSWORD=replace_with_random_hex_secret
DATABASE_URL=postgresql+psycopg://dw:replace_with_random_hex_secret@localhost:5432/dw

# Silo / MinIO-compatible object storage (local development only)
MINIO_ROOT_USER=dwminio
MINIO_ROOT_PASSWORD=replace_with_random_hex_secret

# FastAPI
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRE_MINUTES=60

# Compose sets minio:9000 for the container; use localhost:9000 only for direct host runs.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=dwminio
MINIO_SECRET_KEY=replace_with_the_same_value_as_MINIO_ROOT_PASSWORD
MINIO_BUCKET=evidence
MAX_UPLOAD_MB=100

# Generate a random 32-byte key and Base64-encode it.
EVIDENCE_ENC_KEY=replace_with_base64_encoded_32_random_bytes
RECEIPT_HMAC_KEY=replace_with_at_least_32_random_bytes

# Local-chain settings. Amoy values are supplied to the deploy command and must not be committed.
# AMOY_RPC_URL=
# AMOY_PRIVATE_KEY=

# Amoy demo chain. Set the RPC URL and contract address from your deployment.
# The expected chain ID guard blocks accidental submissions to local Hardhat.
CHAIN_RPC_URL=replace_with_polygon_amoy_rpc_url
CHAIN_EXPECTED_ID=80002
CHAIN_CONTRACT_ADDRESS=replace_with_deployed_contract_address
CHAIN_SENDER_ADDRESS=replace_with_unlocked_node_account
ANCHOR_BATCH_SIZE=10
ANCHOR_INTERVAL_SECONDS=30
ANCHOR_WORKER_POLL_SECONDS=5
ANCHOR_BUILDING_TIMEOUT_SECONDS=300
# For networks without an unlocked sender, set CHAIN_PRIVATE_KEY in your local .env only.

# Frontend and local API access (D)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_USE_MOCK=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional AI analysis (LLM/OCR). Leave disabled for local rules-only analysis.
LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
AI_WORKER_POLL_SECONDS=3
# OCR for screenshots and scanned PDF pages (Tesseract language packs in Docker).
OCR_LANGUAGES=eng+hin+kan
OCR_TIMEOUT_SECONDS=25
