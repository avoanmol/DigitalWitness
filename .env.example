
# PostgreSQL
POSTGRES_DB=dw
POSTGRES_USER=dw
POSTGRES_PASSWORD=change_this_local_password

# MinIO credentials (local development only)
MINIO_ROOT_USER=dwminio
MINIO_ROOT_PASSWORD=change_this_minio_password

# FastAPI configuration (used in upcoming steps)
JWT_SECRET=replace_with_a_random_secret
JWT_EXPIRE_MINUTES=60

# Evidence storage configuration (used in upcoming steps)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=dwminio
MINIO_SECRET_KEY=change_this_minio_password
MINIO_BUCKET=evidence
MAX_UPLOAD_MB=100

# Encryption and receipt signing keys (generate before implementation)
EVIDENCE_ENC_KEY=replace_with_base64_encoded_32_byte_key
RECEIPT_HMAC_KEY=replace_with_a_random_secret
